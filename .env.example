# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration - Uses new google.genai package
# Default model (will auto-fallback to others if quota exceeded)
GEMINI_MODEL=models/gemini-2.0-flash-exp

# Database Configuration
DUCKDB_PATH=./data/retail_insights.duckdb

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/system.log

# Cost Configuration (Free tier - $0, paid tier varies)
GEMINI_INPUT_COST=0.0
GEMINI_OUTPUT_COST=0.0
